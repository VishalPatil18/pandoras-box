# Copy to .env and fill in. Never commit real values.

# Fish Audio API key: https://fish.audio/app/api-keys
FISH_API_KEY=replace-me
# The id of your voice model (used as reference_id in the TTS request).
FISH_MODEL_ID=replace-me
# Optional. Fish TTS model header: s2.1-pro (default), s2-pro, s1, or s2.1-pro-free on the free tier.
FISH_TTS_MODEL=
