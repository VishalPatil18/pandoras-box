# Copy to .env and fill in. Never commit real values.

# Runtime connection. Locally this is the docker-compose database; in production, Supabase's pooled URL.
DATABASE_URL=postgresql://pandoras:pandoras@localhost:5433/pandoras
# Migrations connect directly. Locally the same as DATABASE_URL; in production, Supabase's direct URL.
DIRECT_URL=postgresql://pandoras:pandoras@localhost:5433/pandoras
# Backend tests truncate tables, so they use their own database (created automatically).
TEST_DATABASE_URL=postgresql://pandoras:pandoras@localhost:5433/pandoras_test

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud OAuth client. Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# OpenAI. Server only.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.4-mini
